<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.AddProductController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Thêm Sản Phẩm Đấu Giá" />
    
    <ComboBox fx:id="comboType" prefWidth="300.0" />
    <TextField fx:id="txtName" promptText="Tên sản phẩm" />
    <TextField fx:id="txtDesc" promptText="Mô tả ngắn gọn" />
    <TextField fx:id="txtPrice" promptText="Giá khởi điểm (USD)" />
    <TextField fx:id="txtExtra1" promptText="Thông tin phụ 1" />
    <TextField fx:id="txtExtra2" promptText="Thông tin phụ 2" />

    <Button onAction="#handleSave" prefWidth="300.0" style="-fx-background-color: #0ea5e9; -fx-text-fill: white; -fx-font-weight: bold;" text="Lưu Sản Phẩm" />
</VBox>